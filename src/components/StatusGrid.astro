---
/*
 * Status rack — SSR placeholder tiles (status:'unknown'), then client JS
 * swaps lamps/latency once /api/status resolves. Progressive enhancement:
 * JS-off users + crawlers still see every channel.
 */
import { TARGETS } from '~/data/targets'

const groups = {
  master: TARGETS.filter((t) => t.category === 'master'),
  app: TARGETS.filter((t) => t.category === 'app'),
  api: TARGETS.filter((t) => t.category === 'api'),
}

const labels: Record<string, string> = {
  master: 'Apex',
  app: 'Applications',
  api: 'Interfaces',
}
---
<div class="racks">
  {Object.entries(groups).map(([cat, items]) => items.length > 0 && (
    <section>
      <h2 class="section-title">{labels[cat]}<span class="count">{items.length} ch</span></h2>
      <div class="grid" data-group={cat}>
        {items.map((t) => (
          <a class="tile" data-status="unknown" href={t.url} target="_blank" rel="noopener" data-slug={t.slug}>
            <span class="lamp pulse" aria-hidden="true"></span>
            <span class="chan">{t.name}</span>
            <span class="lat" data-ms>—</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
