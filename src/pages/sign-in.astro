---
import BaseLayout from '~/layouts/BaseLayout.astro'
import SignInPanel from '~/components/auth/SignInPanel'
---
<BaseLayout title="oriz / status — sign in" description="Sign in to the oriz.in family via Clerk SSO.">
  <div class="shell">
    <header class="chrome">
      <span class="brand"><a href="/" style="color:inherit;text-decoration:none"><b>oriz</b><span class="sep">/</span>status<span class="sep">·</span>console</a></span>
      <span class="clock"><a href="/" style="color:var(--ink-mut);text-decoration:none">&larr; console</a></span>
    </header>

    <section class="signin-bay">
      <p class="eyebrow"><span class="beacon" aria-hidden="true"></span> Operator access · oriz.in SSO</p>
      <div class="signin-mount">
        <SignInPanel client:only="react" />
      </div>
    </section>
  </div>

  <style>
    .signin-bay {
      margin: clamp(28px, 6vw, 56px) 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .signin-bay .eyebrow {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mut);
    }
    .signin-bay .beacon {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--sig-up);
      box-shadow: 0 0 8px var(--sig-up);
    }
    .signin-mount { min-height: 400px; display: flex; justify-content: center; }
  </style>
</BaseLayout>
