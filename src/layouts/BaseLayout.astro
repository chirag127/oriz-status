---
import '~/styles/global.css'
import Wordmark from '~/components/Wordmark.astro'
import AuthButton from '~/components/auth/AuthButton.tsx'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz / status — signal console',
  description = 'Live signal console for the oriz.in family — every site and API on one annunciator panel, probed every 5 minutes.',
} = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://status.oriz.in${Astro.url.pathname}`} />
    <meta name="theme-color" content="#0e1a1c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="oriz status incidents" href="/feed.xml" />
    <link rel="preconnect" href="https://status-api.oriz.in" crossorigin />
  </head>
  <body>
    <header class="console-bar">
      <div class="console-bar__inner">
        <Wordmark />
        <div class="console-bar__meta">
          <span class="sep">status console</span>
          <span class="auth-slot"><AuthButton client:load /></span>
        </div>
      </div>
    </header>
    <slot />
  </body>
</html>
