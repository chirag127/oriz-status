{
  "name": "@chirag127/oriz-status-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Custom status page + uptime monitoring for the oriz.in family. CF Worker cron + KV + Astro static. Replaces UptimeRobot.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:pages": "wrangler pages deploy dist --project-name=oriz-status",
    "deploy:worker:ping": "wrangler deploy --config workers/wrangler.ping.toml",
    "deploy:worker:api": "wrangler deploy --config workers/wrangler.api.toml",
    "deploy:all": "pnpm build && pnpm deploy:pages && pnpm deploy:worker:ping && pnpm deploy:worker:api",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@clerk/clerk-react": "^5.61.3",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^6.4.7",
    "firebase": "^12.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
