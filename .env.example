# oriz / status — environment (key names only; real secrets never committed)
# Copy to .env (gitignored) and populate. PUBLIC_* ship to the browser.

# Live status API base (CF Worker + KV). Defaults to https://status-api.oriz.in
PUBLIC_STATUS_API_BASE=https://status-api.oriz.in

# Astro base path (subpath deploys). Root by default.
PUBLIC_BASE_PATH=/

# ── Clerk (browser-safe publishable key; gates only the personal watchlist) ──
# https://dashboard.clerk.com — API Keys. One Clerk org = SSO across *.oriz.in.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Firebase (shared oriz-in project; Firestore ONLY — Clerk owns auth) ──
# https://console.firebase.google.com/project/oriz-app
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=auth.oriz.in
PUBLIC_FIREBASE_PROJECT_ID=oriz-app
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
